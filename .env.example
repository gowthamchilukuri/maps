POSTGRES_DB=gis
POSTGRES_USER=_renderd
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# Geofabrik / OSM.fr area id (see api/src/areas.js)
OSM_AREA=monaco
DEFAULT_INTERVAL_HOURS=12

# Absolute path to this project (needed so the API can docker-run the importer)
HOST_PROJECT_DIR=${PWD}

# Pipeline stages (also set on Lambda / ECS in AWS)
ENABLE_OSM2PGSQL=true
ENABLE_PLANETILER=false
ENABLE_NOMINATIM=false
ENABLE_PLANETILER_UPLOAD=false
# MBTILES_S3_BUCKET=sigeo-map-youraccount   # only for Planetiler
# NOMINATIM_PGHOST=...
# NOMINATIM_PGPASSWORD=...

